<!-- 비밀번호 변경 모달 -->
<div class="modal-bg" id="pw-modal">
  <div class="modal-box">
    <div class="modal-title">비밀번호 변경</div>
    <div class="modal-sub" id="pw-modal-sub">현재 비밀번호를 입력하고 새 비밀번호를 설정하세요.</div>
    <div id="pw-current-wrap">
      <div class="form-row">
        <div class="f-label">현재 비밀번호</div>
        <input class="f-input" type="password" id="pw-current" placeholder="현재 비밀번호">
      </div>
    </div>
    <div class="form-row">
      <div class="f-label">새 비밀번호</div>
      <input class="f-input" type="password" id="pw-new" placeholder="새 비밀번호 (4자 이상)">
    </div>
    <div class="form-row">
      <div class="f-label">새 비밀번호 확인</div>
      <input class="f-input" type="password" id="pw-confirm" placeholder="새 비밀번호 재입력">
    </div>
    <div class="login-err" id="pw-err" style="margin-bottom:10px"></div>
    <div class="btn-row" style="margin-top:0">
      <button class="btn btn-outline" onclick="closePwModal()">취소</button>
      <button class="btn btn-accent" onclick="changePw()">변경하기</button>
    </div>
  </div>
</div>

<div class="notif" id="notif"></div>

<script>
const API = "https://script.google.com/macros/s/AKfycbylpaiUCTxCeIsXwDkitfuZYgjWbJofsp6839Vd1ZVKGwetDjx0cF_DyZF-C-MmyveM/exec";

let currentUser = null;
let portfolioItems = [];
let skillItems = [];
let projectRows = [];
let selectedAI = "미활용";
let editingId = null;
let assetFields = [];
let pwModalFromLogin = false;

// 반기 관리 — 포트폴리오
let pfPeriods = ["26년도 상반기", "26년도 하반기"];
let activePfPeriod = "26년도 상반기";

// 반기 관리 — 툴 스킬
let periods = ["26년도 상반기", "26년도 하반기"];
let activePeriod = "26년도 상반기";

function renderPfPeriodTabs() {
  const wrap = document.getElementById("pf-period-tabs");
  if (!wrap) return;
  wrap.innerHTML = pfPeriods.map(p => `
    <button class="period-tab btn-sm ${p===activePfPeriod?'active':''}" style="padding:5px 12px;font-size:12px" onclick="selectPfPeriod('${p}')">${p}</button>`).join('');
}

async function selectPfPeriod(p) {
  activePfPeriod = p;
  renderPfPeriodTabs();
  await Promise.all([loadPortfolio(), loadProjects()]);
}

function addPfPeriod() {
  const name = prompt("반기명을 입력하세요 (예: 27년도 상반기)");
  if (!name || !name.trim()) return;
  if (pfPeriods.includes(name.trim())) { showNotif("이미 존재하는 반기예요"); return; }
  pfPeriods.push(name.trim());
  selectPfPeriod(name.trim());
}


async function apiGet(params) {
  const res = await fetch(API + "?" + new URLSearchParams(params));
  return res.json();
}
async function apiPost(body) {
  const url = API + "?" + new URLSearchParams(body);
  const res = await fetch(url, { redirect: "follow" });
  return res.json();
}

window.onload = () => {
  const saved = localStorage.getItem("pf_email");
  if (saved) loginWithEmail(saved, null);
  else { showLoading(false); document.getElementById("login-screen").style.display = "flex"; }
};

async function login() {
  const email = document.getElementById("email-input").value.trim();
  const pw = document.getElementById("pw-input").value.trim();
  if (!email || !pw) { showLoginErr("이메일과 비밀번호를 입력해주세요"); return; }
  await loginWithEmail(email, pw);
}

async function loginWithEmail(email, pw) {
  showLoading(true);
  try {
    const data = await apiGet({ action: "getUser", email });
    if (!data.ok) { showLoading(false); document.getElementById("login-screen").style.display = "flex"; showLoginErr(data.error); return; }
    if (data.user.role !== "member") { showLoading(false); document.getElementById("login-screen").style.display = "flex"; showLoginErr("팀원 전용 페이지입니다."); return; }
    if (pw !== null) {
      const stored = data.user.password || "0000";
      if (String(pw) !== String(stored)) { showLoading(false); document.getElementById("login-screen").style.display = "flex"; showLoginErr("비밀번호가 올바르지 않습니다."); return; }
    }
    currentUser = data.user;
    localStorage.setItem("pf_email", email);
    await initApp();
  } catch(e) {
    showLoading(false);
    document.getElementById("login-screen").style.display = "flex";
    showLoginErr("연결 오류: " + e.message);
    console.error("Login error:", e);
  }
}

async function initApp() {
  document.getElementById("user-nm").textContent = currentUser.name;
  document.getElementById("user-av").textContent = currentUser.name[0];
  document.getElementById("user-rank").textContent = currentUser.rank || currentUser.job || "—";
  renderProfile();
  await Promise.all([loadPortfolio(), loadSkills(), loadProjects()]);
  showLoading(false);
  document.getElementById("login-screen").style.display = "none";
  document.getElementById("app").style.display = "block";
  renderPeriodTabs();
  renderPfPeriodTabs();
}

function logout() { localStorage.removeItem("pf_email"); location.reload(); }
function showLoginErr(msg) { const el = document.getElementById("login-err"); el.textContent = msg; el.style.display = "block"; }

// ── 비밀번호 ──
function showPwModal(fromLogin) {
  pwModalFromLogin = fromLogin;
  document.getElementById("pw-modal-sub").textContent = fromLogin ? "최초 비밀번호(0000)를 변경해주세요." : "현재 비밀번호를 입력하고 새 비밀번호를 설정하세요.";
  document.getElementById("pw-current-wrap").style.display = fromLogin ? "none" : "block";
  ["pw-current","pw-new","pw-confirm"].forEach(id => document.getElementById(id).value = "");
  document.getElementById("pw-err").style.display = "none";
  document.getElementById("pw-modal").classList.add("show");
}
function closePwModal() { document.getElementById("pw-modal").classList.remove("show"); }
async function changePw() {
  const cur = document.getElementById("pw-current").value.trim();
  const nw = document.getElementById("pw-new").value.trim();
  const cf = document.getElementById("pw-confirm").value.trim();
  const errEl = document.getElementById("pw-err");
  if (!pwModalFromLogin && !cur) { errEl.textContent = "현재 비밀번호를 입력해주세요"; errEl.style.display = "block"; return; }
  if (nw.length < 4) { errEl.textContent = "비밀번호는 4자 이상이어야 해요"; errEl.style.display = "block"; return; }
  if (nw !== cf) { errEl.textContent = "새 비밀번호가 일치하지 않아요"; errEl.style.display = "block"; return; }
  if (!pwModalFromLogin && cur !== String(currentUser.password || "0000")) { errEl.textContent = "현재 비밀번호가 올바르지 않아요"; errEl.style.display = "block"; return; }
  const data = await apiPost({ action: "changePassword", email: currentUser.email, new_password: nw });
  if (data.ok) { currentUser.password = nw; closePwModal(); showNotif("비밀번호가 변경되었습니다"); }
  else { errEl.textContent = "변경 실패: " + data.error; errEl.style.display = "block"; }
}

// ── 담당 프로젝트 ──
// ── 담당 프로젝트 저장/로드 ───────────────────────────
async function loadProjects() {
  const data = await apiGet({ action: "getProjects", email: currentUser.email, period: activePfPeriod });
  if (data.ok) {
    projectRows = data.items.length > 0
      ? data.items.map(p => ({ name: p.name||p.project_name||"", count: p.count||p.monthly_count||"" }))
      : [];
    renderProjectRows();
  }
}

async function saveProjects() {
  const data = await apiPost({
    action: "saveProjects",
    member_email: currentUser.email,
    period: activePfPeriod,
    projects: JSON.stringify(projectRows.filter(p => p.name.trim()))
  });
  if (data.ok) showNotif("프로젝트 목록이 저장되었습니다");
  else showNotif("저장 실패: " + data.error);
}

function renderProjectRows() {
  document.getElementById("project-rows").innerHTML = projectRows.map((p, i) => `
    <div class="project-item">
      <span class="project-idx">${i + 1}</span>
      <input class="proj-name" type="text" placeholder="프로젝트명" value="${p.name||''}" oninput="projectRows[${i}].name=this.value">
      <input class="proj-count" type="text" placeholder="월 제작건수 예) 35~45건" value="${p.count||''}" oninput="projectRows[${i}].count=this.value">
      <button class="proj-del" onclick="removeProject(${i})">✕</button>
    </div>`).join('');
}
function addProjectRow() { projectRows.push({ name:"", count:"" }); renderProjectRows(); document.querySelectorAll(".proj-name")[projectRows.length-1]?.focus(); }
function removeProject(i) { projectRows.splice(i,1); renderProjectRows(); }

// ── 포트폴리오 ──
async function loadPortfolio() {
  const data = await apiGet({ action:"getPortfolio", email:currentUser.email, period:activePfPeriod });
  if (data.ok) { portfolioItems = data.items||[]; renderPortfolio(); }
}

function getContribColor(pct) {
  const n = parseInt(pct)||0;
  if (n===100) return { bg:"#E6F7F0", color:"#12A76A" };
  if (n>=70)   return { bg:"#EEF0FE", color:"#5B6BF5" };
  if (n>=40)   return { bg:"#FEF3E2", color:"#E07B00" };
  return               { bg:"#F0F1F6", color:"#565A70" };
}

function formatDate(d) {
  if (!d) return "—";
  const s = String(d);
  if (s.includes("T")||s.includes("GMT")) {
    const dt = new Date(d);
    return `${dt.getFullYear()}-${String(dt.getMonth()+1).padStart(2,'0')}-${String(dt.getDate()).padStart(2,'0')}`;
  }
  return s.substring(0,10);
}

function getYoutubeThumbnail(url) {
  const patterns = [
    /youtube\.com\/watch\?v=([^&]+)/,
    /youtu\.be\/([^?&]+)/,
    /youtube\.com\/embed\/([^?&]+)/,
    /youtube\.com\/shorts\/([^?&]+)/,
  ];
  for (const p of patterns) {
    const m = url.match(p);
    if (m) return `https://img.youtube.com/vi/${m[1]}/hqdefault.jpg`;
  }
  return null;
}

function renderAssetPreview(url, type, thumbUrl) {
  if (!url) return '';
  const isDrive = url.includes("drive.google.com");
  const isInsta = url.includes("instagram.com");
  const isYT    = url.includes("youtube.com") || url.includes("youtu.be");
  const icon    = isDrive ? "📁" : isInsta ? "📷" : isYT ? "▶️" : "🔗";
  const typeLbl = isDrive ? "Google Drive" : isInsta ? "Instagram" : isYT ? "YouTube" : "링크";
  const shortUrl = url.length > 45 ? url.substring(0, 45) + "…" : url;

  let thumbHtml = '';

  if (thumbUrl && thumbUrl.trim()) {
    // 직접 입력한 썸네일 우선
    thumbHtml = `<div class="asset-thumb-wrap"><img class="asset-thumb" src="${thumbUrl.trim()}" onerror="this.parentElement.innerHTML='<div class=\\'asset-thumb-ph\\'>${icon}</div>'" loading="lazy"></div>`;
  } else if (isYT) {
    // 유튜브 자동 썸네일
    const ytThumb = getYoutubeThumbnail(url);
    thumbHtml = ytThumb
      ? `<div class="asset-thumb-wrap"><img class="asset-thumb" src="${ytThumb}" onerror="this.parentElement.innerHTML='<div class=\\'asset-thumb-ph\\'>▶️</div>'" loading="lazy"></div>`
      : `<div class="asset-thumb-wrap"><div class="asset-thumb-ph">▶️</div></div>`;
  } else if (isDrive) {
    // 구글 드라이브 썸네일
    const m = url.match(/[-\w]{25,}/);
    thumbHtml = m
      ? `<div class="asset-thumb-wrap"><img class="asset-thumb" src="https://drive.google.com/thumbnail?id=${m[0]}&sz=w400" onerror="this.parentElement.innerHTML='<div class=\\'asset-thumb-ph\\'>📁</div>'" loading="lazy"></div>`
      : `<div class="asset-thumb-wrap"><div class="asset-thumb-ph">📁</div></div>`;
  } else {
    // SNS 링크 등 — 썸네일 없음 (직접 이미지 입력 필요)
    thumbHtml = `<div class="asset-thumb-wrap"><div class="asset-thumb-ph">${icon}</div></div>`;
  }

  return `
    <div class="asset-item" onclick="window.open('${url}','_blank')">
      ${thumbHtml}
      <div class="asset-info">
        <div class="asset-type-lbl">${typeLbl}</div>
        <div class="asset-url-txt" title="${url}">${shortUrl}</div>
      </div>
    </div>`;
}

function renderPortfolio() {
  document.getElementById("pf-ct").textContent = portfolioItems.length;
  const submitted = portfolioItems.filter(p=>p.is_submitted===true||p.is_submitted==="TRUE").length;
  const total = portfolioItems.length;
  document.getElementById("s-dot").style.background = submitted>0?"var(--green)":total>0?"var(--amber)":"var(--text3)";
  document.getElementById("s-text").innerHTML = `<b>${total}건</b> 기록됨${submitted>0?` · <b>${submitted}건</b> 제출 완료`:" · 미제출"}`;
  const list = document.getElementById("pf-list");
  if (!total) { list.innerHTML = `<div class="empty-state"><div class="empty-icon">📭</div>아직 기록된 작업물이 없어요</div>`; return; }
  list.innerHTML = portfolioItems.map(item => {
    const done = item.is_submitted===true||item.is_submitted==="TRUE";
    const sp = item.status==="완료"
      ? `<span class="status-pill" style="background:var(--green-light);color:var(--green)">완료</span>`
      : `<span class="status-pill" style="background:var(--amber-light);color:var(--amber)">진행중</span>`;
    const cc = getContribColor(item.contribution_pct);
    const assets = (() => { try { return JSON.parse(item.asset_url||"[]"); } catch(e) { return item.asset_url?[{type:item.asset_type||"link",url:item.asset_url}]:[]; } })();
    return `
    <div class="pf-card">
      <div class="pf-card-hd" onclick="toggleCard('${item.id}')">
        ${sp}
        <div class="pf-card-info">
          <div class="pf-card-title">${item.client||''} ${item.channel||''} · ${item.work_title||''}</div>
          <div class="pf-card-meta">
            <span>${formatDate(item.date_start)} ~ ${formatDate(item.date_end)}</span>
            <span class="contrib-pill" style="background:${cc.bg};color:${cc.color}">기여율 ${item.contribution_pct||0}%</span>
            ${item.collaborator?`<span>협업: ${item.collaborator}</span>`:''}
          </div>
        </div>
        <div class="pf-card-acts">
          ${done?'<span style="font-size:11px;color:var(--green);font-weight:600">제출완료</span>'
            :`<button class="btn btn-outline btn-sm" onclick="event.stopPropagation();editItem('${item.id}')">수정</button>
              <button class="btn btn-danger" onclick="event.stopPropagation();deleteItem('${item.id}')">삭제</button>`}
          <span style="font-size:11px;color:var(--text3)">▾</span>
        </div>
      </div>
      <div class="pf-card-body" id="body-${item.id}">
        <div class="pf-body-grid">
          <div class="pf-field"><div class="pf-fl">디자인 툴</div><div class="pf-fv">${item.tools_design||'—'}</div></div>
          <div class="pf-field"><div class="pf-fl">AI 활용</div><div class="pf-fv">${item.ai_usage||'—'}${item.ai_tools?` · ${item.ai_tools}`:''}${item.ai_detail?`<div style="font-size:12px;color:var(--text2);margin-top:3px">${item.ai_detail}</div>`:''}</div></div>
        </div>
        ${item.work_desc?`<div class="pf-txt">${item.work_desc}</div>`:''}
        ${assets.length?`<div class="assets-wrap"><div class="assets-title">첨부 작업물</div><div class="assets-grid">${assets.map(a=>renderAssetPreview(a.url,a.type,a.thumbUrl||"")).join('')}</div></div>`:''}
        ${(item.tip_consider||item.tip_develop||item.tip_quality)?`
        <div class="pf-tip-wrap">
          <div class="pf-tip-hd">✦ 작성 TIP</div>
          ${item.tip_consider?`<div class="pf-tip-item"><div class="pf-tip-lbl">고려한 포인트</div><div class="pf-tip-txt">${item.tip_consider}</div></div>`:''}
          ${item.tip_develop?`<div class="pf-tip-item"><div class="pf-tip-lbl">발전 포인트</div><div class="pf-tip-txt">${item.tip_develop}</div></div>`:''}
          ${item.tip_quality?`<div class="pf-tip-item"><div class="pf-tip-lbl">완성도 & 개선 포인트</div><div class="pf-tip-txt">${item.tip_quality}</div></div>`:''}
        </div>`:''}
      </div>
    </div>`;
  }).join('');
}

function toggleCard(id) { document.getElementById("body-"+id)?.classList.toggle("open"); }

// 첨부 필드
function addAssetField(url='', type='sns_link', thumbUrl='') {
  const idx = assetFields.length;
  assetFields.push({ url, type, thumbUrl });
  const wrap = document.getElementById("asset-list-form");
  const div = document.createElement("div");
  div.className = "asset-form-item";
  div.id = "af-"+idx;
  div.innerHTML = `
    <div class="attach-type-row">
      <button class="att-type-btn ${type==='sns_link'?'on':''}" onclick="setAType(${idx},this,'sns_link')">🔗 SNS 링크</button>
      <button class="att-type-btn ${type==='drive_link'?'on':''}" onclick="setAType(${idx},this,'drive_link')">📁 드라이브</button>
    </div>
    <div style="margin-bottom:7px">
      <div style="font-size:11px;color:var(--text3);margin-bottom:4px;font-weight:500">링크</div>
      <div class="asset-form-row">
        <input class="f-input" style="flex:1;margin-bottom:0" type="text" placeholder="SNS 링크 또는 드라이브 링크" value="${url}" oninput="assetFields[${idx}].url=this.value">
        <button class="btn btn-danger btn-sm" onclick="removeAF(${idx})">삭제</button>
      </div>
    </div>
    <div>
      <div style="font-size:11px;color:var(--text3);margin-bottom:4px;font-weight:500">썸네일 이미지 URL <span style="font-weight:400">(선택 — 작업물 이미지를 직접 캡처 후 드라이브에 올려 링크 입력)</span></div>
      <input class="f-input" style="margin-bottom:0" type="text" placeholder="예) https://drive.google.com/..." value="${thumbUrl}" oninput="assetFields[${idx}].thumbUrl=this.value">
    </div>`;
  wrap.appendChild(div);
}
function setAType(idx,btn,type) { assetFields[idx].type=type; btn.closest(".attach-type-row").querySelectorAll(".att-type-btn").forEach(b=>b.classList.remove("on")); btn.classList.add("on"); }
function removeAF(idx) { document.getElementById("af-"+idx)?.remove(); assetFields[idx]=null; }

// 폼
function openAddForm() { editingId=null; assetFields=[]; document.getElementById("asset-list-form").innerHTML=""; document.getElementById("form-title-label").textContent="작업물 추가"; clearForm(); document.getElementById("pf-form").style.display="block"; document.getElementById("pf-form").scrollIntoView({behavior:"smooth"}); }
function editItem(id) {
  const item = portfolioItems.find(p=>p.id==id); if(!item) return;
  editingId=id; assetFields=[]; document.getElementById("asset-list-form").innerHTML="";
  document.getElementById("form-title-label").textContent="작업물 수정";
  fillForm(item);
  try { const assets=JSON.parse(item.asset_url||"[]"); assets.forEach(a=>addAssetField(a.url,a.type,a.thumbUrl||"")); } catch(e) { if(item.asset_url) addAssetField(item.asset_url,item.asset_type||"sns_link",""); }
  document.getElementById("pf-form").style.display="block"; document.getElementById("pf-form").scrollIntoView({behavior:"smooth"});
}
function clearForm() {
  ["f-client","f-title","f-tools","f-collab","f-desc","f-tip1","f-tip2","f-tip3"].forEach(id=>{const el=document.getElementById(id);if(el)el.value="";});
  ["f-channel","f-status"].forEach(id=>document.getElementById(id).value="");
  document.getElementById("f-date-start").value=""; document.getElementById("f-date-end").value="";
  document.getElementById("f-contrib").value=100; document.getElementById("f-contrib-val").textContent="100%";
  document.getElementById("f-collab-pct").value=""; document.getElementById("f-ai-tools").value=""; document.getElementById("f-ai-detail").value="";
  document.getElementById("form-id").value="";
  document.querySelectorAll(".ai-opt").forEach(el=>el.classList.remove("on")); document.querySelector(".ai-opt").classList.add("on"); selectedAI="미활용";
  document.getElementById("ai-detail-wrap").style.display="none";
}
function fillForm(item) {
  document.getElementById("form-id").value=item.id;
  document.getElementById("f-client").value=item.client||""; document.getElementById("f-channel").value=item.channel||"";
  document.getElementById("f-title").value=item.work_title||""; document.getElementById("f-status").value=item.status||"";
  document.getElementById("f-date-start").value=formatDate(item.date_start); document.getElementById("f-date-end").value=formatDate(item.date_end);
  document.getElementById("f-contrib").value=item.contribution_pct||100; document.getElementById("f-contrib-val").textContent=(item.contribution_pct||100)+"%";
  document.getElementById("f-tools").value=item.tools_design||""; document.getElementById("f-collab").value=item.collaborator||"";
  document.getElementById("f-collab-pct").value=item.collaborator_pct||""; document.getElementById("f-desc").value=item.work_desc||"";
  document.getElementById("f-tip1").value=item.tip_consider||""; document.getElementById("f-tip2").value=item.tip_develop||""; document.getElementById("f-tip3").value=item.tip_quality||"";
  const ai=item.ai_usage||"미활용";
  document.querySelectorAll(".ai-opt").forEach(el=>el.classList.toggle("on",el.textContent===ai)); selectedAI=ai;
  document.getElementById("ai-detail-wrap").style.display=ai!=="미활용"?"block":"none";
  document.getElementById("f-ai-tools").value=item.ai_tools||""; document.getElementById("f-ai-detail").value=item.ai_detail||"";
}
function closeForm() { document.getElementById("pf-form").style.display="none"; editingId=null; }

async function saveItem() {
  const req=[{id:"f-client"},{id:"f-channel"},{id:"f-title"},{id:"f-status"},{id:"f-date-start"},{id:"f-date-end"},{id:"f-tools"}];
  let valid=true;
  req.forEach(r=>{const el=document.getElementById(r.id);if(!el.value.trim()){el.classList.add("err");valid=false;}else el.classList.remove("err");});
  if(!valid){showNotif("필수 항목을 모두 입력해주세요");return;}
  const btn=document.getElementById("save-btn"); btn.disabled=true; btn.innerHTML='<span style="display:inline-block;width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite"></span>';
  const assets=assetFields.filter(a=>a&&a.url.trim()).map(a=>({type:a.type,url:a.url.trim(),thumbUrl:a.thumbUrl||""}));
  const body={action:"savePortfolioItem",member_email:currentUser.email,id:editingId||"",
    period:activePfPeriod,
    client:document.getElementById("f-client").value.trim(),channel:document.getElementById("f-channel").value,
    work_title:document.getElementById("f-title").value.trim(),status:document.getElementById("f-status").value,
    date_start:document.getElementById("f-date-start").value,date_end:document.getElementById("f-date-end").value,
    contribution_pct:document.getElementById("f-contrib").value,tools_design:document.getElementById("f-tools").value.trim(),
    collaborator:document.getElementById("f-collab").value.trim(),collaborator_pct:document.getElementById("f-collab-pct").value,
    ai_usage:selectedAI,ai_tools:document.getElementById("f-ai-tools").value.trim(),ai_detail:document.getElementById("f-ai-detail").value.trim(),
    asset_type:"multi",asset_url:JSON.stringify(assets),
    work_desc:document.getElementById("f-desc").value.trim(),tip_consider:document.getElementById("f-tip1").value.trim(),
    tip_develop:document.getElementById("f-tip2").value.trim(),tip_quality:document.getElementById("f-tip3").value.trim()};
  const data=await apiPost(body);
  btn.disabled=false; btn.textContent="저장";
  if(data.ok){showNotif(editingId?"수정되었습니다":"저장되었습니다");closeForm();await loadPortfolio();}
  else showNotif("저장 실패: "+data.error);
}
async function deleteItem(id){if(!confirm("삭제하시겠어요?"))return;const data=await apiPost({action:"deletePortfolioItem",id});if(data.ok){showNotif("삭제되었습니다");await loadPortfolio();}else showNotif("삭제 실패: "+data.error);}
async function openSubmitConfirm(){
  const unsub=portfolioItems.filter(p=>p.is_submitted!==true&&p.is_submitted!=="TRUE").length;
  if(!unsub){showNotif("제출할 작업물이 없어요");return;}
  if(!confirm(`미제출 작업물 ${unsub}건을 반기 제출하겠습니까?\n제출 후에는 수정이 불가합니다.`))return;
  showLoading(true);const data=await apiPost({action:"submitPortfolio",email:currentUser.email,period:activePfPeriod});showLoading(false);
  if(data.ok){showNotif(`${data.submitted_count}건 제출 완료`);await loadPortfolio();}else showNotif("제출 실패: "+data.error);
}

// ── 툴 스킬 반기 탭 ──
function renderPeriodTabs() {
  const wrap = document.getElementById("period-tabs");
  if (!wrap) return;
  wrap.innerHTML = periods.map(p => `
    <button class="period-tab ${p===activePeriod?'active':''}" onclick="selectPeriod('${p}',this)">${p}</button>`).join('');
}
function selectPeriod(p, btn) {
  activePeriod = p;
  renderPeriodTabs();
  document.getElementById("skill-period-label").textContent = p + " 툴 목록";
  renderSkills();
}
function addPeriod() {
  const name = prompt("반기명을 입력하세요 (예: 27년도 상반기)");
  if (!name || !name.trim()) return;
  if (periods.includes(name.trim())) { showNotif("이미 존재하는 반기예요"); return; }
  periods.push(name.trim());
  activePeriod = name.trim();
  renderPeriodTabs();
  document.getElementById("skill-period-label").textContent = activePeriod + " 툴 목록";
  renderSkills();
}

async function loadSkills() {
  const data = await apiGet({ action:"getSkills", email:currentUser.email, period:activePeriod });
  if (data.ok) { skillItems = data.items||[]; renderSkills(); }
}
const lvMap={"전문가 리드":"lv5","고급 응용":"lv4","실무 활용":"lv3","기본 활용":"lv2","기초 경험":"lv1"};
function renderSkills() {
  const el = document.getElementById("skill-list");
  const filtered = skillItems.filter(s => !s.period || s.period === activePeriod);
  if (!filtered.length) { el.innerHTML=`<div class="empty-state"><div class="empty-icon">🛠</div>${activePeriod}에 등록된 툴이 없어요</div>`; return; }
  el.innerHTML = filtered.map(s=>`
    <div class="skill-item">
      <div style="flex:1">
        <div class="skill-name">${s.tool_name} <span class="skill-type">${s.tool_type}</span></div>
        ${s.experience?`<div class="skill-desc">${s.experience}</div>`:''}
      </div>
      <div style="display:flex;align-items:center;gap:7px">
        <span class="lv ${lvMap[s.level]||'lv1'}">${s.level||'미기재'}</span>
        <button class="btn btn-danger btn-sm" onclick="deleteSkill('${s.id}')">삭제</button>
      </div>
    </div>`).join('');
}
function openSkillForm(){document.getElementById("skill-form").style.display="block";document.getElementById("sk-name").focus();}
function closeSkillForm(){document.getElementById("skill-form").style.display="none";}
async function saveSkill(){
  const name=document.getElementById("sk-name").value.trim(),type=document.getElementById("sk-type").value,level=document.getElementById("sk-level").value;
  if(!name||!type||!level){showNotif("툴 이름, 유형, 숙련도를 모두 입력해주세요");return;}
  const data=await apiPost({action:"saveSkill",member_email:currentUser.email,tool_name:name,tool_type:type,level,experience:document.getElementById("sk-exp").value.trim(),period:activePeriod});
  if(data.ok){showNotif("저장되었습니다");closeSkillForm();["sk-name","sk-type","sk-level","sk-exp"].forEach(id=>document.getElementById(id).value="");await loadSkills();}
  else showNotif("저장 실패: "+data.error);
}
async function deleteSkill(id){if(!confirm("삭제하시겠어요?"))return;const data=await apiPost({action:"deleteSkill",id});if(data.ok){showNotif("삭제되었습니다");await loadSkills();}}

// ── 프로필 ──
function renderProfile(){
  const f=[["이름",currentUser.name],["직책",currentUser.rank],["본부",currentUser.dept],["팀",currentUser.team],["직무",currentUser.job],["입사일",formatDate(currentUser.joined)]];
  document.getElementById("profile-grid").innerHTML=f.map(([l,v])=>`<div class="form-row"><div class="f-label">${l}</div><div class="readonly-field">${v||"—"}</div></div>`).join('');
}

// ── UI ──
function switchTab(id,btn){
  document.querySelectorAll(".section").forEach(s=>s.classList.remove("active"));
  document.querySelectorAll(".nav-item").forEach(t=>t.classList.remove("active"));
  document.getElementById("section-"+id).classList.add("active");
  btn.classList.add("active");
}
function selectAI(el,val){
  document.querySelectorAll(".ai-opt").forEach(o=>o.classList.remove("on")); el.classList.add("on"); selectedAI=val;
  document.getElementById("ai-detail-wrap").style.display=val!=="미활용"?"block":"none";
}
function toggleCaution() {
  const body = document.getElementById("caution-body");
  const chevron = document.getElementById("caution-chevron");
  body.classList.toggle("open");
  chevron.classList.toggle("open");
}

function showLoading(show){document.getElementById("loading-overlay").style.display=show?"flex":"none";}
function showNotif(msg){const n=document.getElementById("notif");n.textContent=msg;n.classList.add("show");setTimeout(()=>n.classList.remove("show"),2400);}
</script>
</body>
